#!/bin/bash
# git-safe-push-master: Publish local trunk with off-tree reconciliation.
#
# Synchronizes the local trunk branch using an off-tree squash + serialized push.
# After publication, clean upstream paths may be materialized to index/worktree;
# locally changed paths are retained. The commit flock serializes cooperating Git
# operations, NOT ordinary editors. Quiesce other filesystem writers when running:
# the check followed by checkout is not atomic against uncoordinated file edits.
#
# Trunk/remote are derived, not hardcoded (a fork whose default branch is `main`
# works with no changes):
#   - remote: $GIT_SAFE_REMOTE, else `origin`
#   - trunk:  $GIT_SAFE_TRUNK, else `$REMOTE/HEAD` (git symbolic-ref), else `master`
# The name "push-master" is kept for back-compat; it publishes whatever the
# derived trunk is.
#
# Usage: git-safe-push-master [-h|--help] [--dry-run]
#        --dry-run fetches and previews without publishing or updating local trunk.
#        GIT_SAFE_PUSH_LOCK_TIMEOUT=30 git-safe-push-master
#        GIT_SAFE_TRUNK=main git-safe-push-master          # override derived trunk
#        GIT_SAFE_REMOTE=upstream git-safe-push-master     # override remote
#
# Exit codes:
#   0 = success (published local commits to the remote, or already in sync)
#   1 = conflict (merge conflict, commits remain local)
#   2 = error (lock timeout, fetch failed, or push rejected after 3 retries)
#
# Push retry: the squash-push step retries up to 3 times only when the remote
# actually advances between our rejected push and a refetch. Local hook/auth/policy
# failures are surfaced verbatim and stop immediately; they are not remote races.
#
# Design: creates a single squash commit (one parent = remote trunk) to avoid merge
# commits, which are prohibited by some repository rulesets. The squash collapses
# multiple local commits into one "sync" commit in the remote's history, but
# correctly preserves all file content. The local trunk is updated only AFTER a
# successful push — this prevents merge-commit accumulation from failed pushes.
#
# Known trade-off: individual commit granularity is not preserved on the remote
# trunk. This is acceptable for a shared hot-trunk model where many sessions
# commit concurrently. A cherry-pick approach would preserve history but fails on
# empty-commit scenarios caused by auto-sync merge commit content.

set -uo pipefail

usage() {
    cat <<'EOF'
Usage: git-safe-push-master [-h|--help] [--dry-run]

Publish local trunk using the shared commit lock and off-tree reconciliation.
  -h, --help  Show this help without running git or acquiring the lock.
  --dry-run   Take the shared commit lock, fetch and preview; never publish,
              create a commit, or update local trunk, index or working tree.
              Fetch updates tracking refs; merge-tree may write git objects.

Environment: GIT_SAFE_REMOTE (origin), GIT_SAFE_TRUNK (remote HEAD, else master),
             GIT_SAFE_PUSH_LOCK_TIMEOUT (60 seconds).
Exit codes: 0 success/clean preview, 1 conflict, 2 error/invalid argument.
EOF
}

DRY_RUN=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dry-run) DRY_RUN=1 ;;
        *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)" || {
    echo "error: not in a git repository" >&2
    exit 2
}

# --- Derive remote + trunk (no hardcoded `master`/`origin`). ---
REMOTE="${GIT_SAFE_REMOTE:-origin}"
TRUNK="${GIT_SAFE_TRUNK:-}"
if [ -z "$TRUNK" ]; then
    # `git symbolic-ref refs/remotes/<remote>/HEAD` yields e.g. "origin/main".
    TRUNK="$(git symbolic-ref --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null | sed "s|^$REMOTE/||")"
fi
[ -n "$TRUNK" ] || TRUNK="master"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || true
if [ "$CURRENT_BRANCH" != "$TRUNK" ]; then
    echo "error: git-safe-push-master only works on the trunk branch '$TRUNK' (on: $CURRENT_BRANCH)" >&2
    echo "       set GIT_SAFE_TRUNK to override the derived trunk if this is wrong" >&2
    exit 2
fi

LOCKFILE="$GIT_DIR/commit.lock"
LOCK_TIMEOUT=${GIT_SAFE_PUSH_LOCK_TIMEOUT:-60}
case "$LOCK_TIMEOUT" in
    *[!0-9]*) echo "error: GIT_SAFE_PUSH_LOCK_TIMEOUT must be a positive integer" >&2; exit 2 ;;
    *) [ "$LOCK_TIMEOUT" -ge 1 ] || { echo "error: GIT_SAFE_PUSH_LOCK_TIMEOUT must be >= 1" >&2; exit 2; } ;;
esac

# Cleanup trap: release the lock
trap 'exec 9>&-' EXIT

# Acquire the shared commit lock (same flock as git-safe-commit)
exec 9>"$LOCKFILE"
if ! flock --timeout "$LOCK_TIMEOUT" 9; then
    echo "error: timed out waiting for commit lock (${LOCK_TIMEOUT}s)" >&2
    exit 2
fi

if ! git fetch "$REMOTE" "$TRUNK" 2>/dev/null; then
    echo "error: git fetch $REMOTE $TRUNK failed" >&2
    exit 2
fi

LOCAL_SHA=$(git rev-parse HEAD 2>/dev/null) || { echo "error: could not resolve HEAD" >&2; exit 2; }
REMOTE_SHA=$(git rev-parse "$REMOTE/$TRUNK" 2>/dev/null) || { echo "error: could not resolve $REMOTE/$TRUNK" >&2; exit 2; }

if [ "$LOCAL_SHA" = "$REMOTE_SHA" ]; then
    echo "✓ Already in sync with $REMOTE/$TRUNK"
    exit 0
fi

# Get count of local non-merge commits to report
LOCAL_COMMIT_COUNT=$(git log --no-merges --format="%H" "$REMOTE_SHA".."$LOCAL_SHA" | wc -l)

if [ "$LOCAL_COMMIT_COUNT" -eq 0 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        echo "Dry-run: would reset local trunk to $REMOTE/$TRUNK (no unpublished non-merge commits); no changes made"
        exit 0
    fi
    # Only merge commits locally — accumulated from previous failed pushes; discard them
    if git update-ref "refs/heads/$TRUNK" "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
        echo "✓ Discarded local-only merge commits; reset to $REMOTE/$TRUNK"
    else
        echo "warning: could not update local $TRUNK (concurrent commit?)" >&2
    fi
    exit 0
fi

push_with_output() {
    local output_file="$1" trace_file="$2"
    shift 2
    if GIT_TRACE2_EVENT="$trace_file" git push "$@" >"$output_file" 2>&1; then
        cat "$output_file"
        return 0
    fi
    return 1
}

push_rejected_by_local_hook() {
    local trace_file="$1"
    python3 - "$trace_file" <<'PY'
import json
import sys

started_hooks: set[int] = set()
with open(sys.argv[1], encoding="utf-8") as trace:
    for line in trace:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("event") == "child_start" and event.get("child_class") == "hook":
            started_hooks.add(event.get("child_id"))
        elif (
            event.get("event") == "child_exit"
            and event.get("child_id") in started_hooks
            and event.get("code", 0) != 0
        ):
            raise SystemExit(0)
raise SystemExit(1)
PY
}

push_failure_or_retry_race() {
    local output_file="$1" trace_file="$2" attempt="$3" previous_remote="$4" refreshed_remote

    if push_rejected_by_local_hook "$trace_file"; then
        cat "$output_file" >&2
        echo "error: local pre-push hook rejected the push; not retrying." >&2
        return 2
    fi
    if ! git fetch "$REMOTE" "$TRUNK" >/dev/null 2>&1; then
        cat "$output_file" >&2
        echo "error: git fetch $REMOTE $TRUNK failed after rejected push" >&2
        return 2
    fi
    refreshed_remote=$(git rev-parse "$REMOTE/$TRUNK" 2>/dev/null) || {
        cat "$output_file" >&2
        echo "error: could not resolve $REMOTE/$TRUNK after rejected push" >&2
        return 2
    }
    if [ "$refreshed_remote" = "$previous_remote" ]; then
        cat "$output_file" >&2
        echo "error: local pre-push hook, authentication, or remote policy rejected the push; $REMOTE/$TRUNK did not advance" >&2
        echo "       Not retrying: this was not a remote race." >&2
        return 2
    fi
    echo "  Push attempt $attempt rejected because the remote raced ahead, recomputing..." >&2
    REMOTE_SHA="$refreshed_remote"
    return 0
}

# Fast path: if local has no merge commits and is a simple descendant, try direct push.
# Keep failure output until a refetch proves whether this was a real race.
LOCAL_MERGE_COUNT=$(git log --merges --format="%H" "$REMOTE_SHA".."$LOCAL_SHA" | wc -l)
if [ "$LOCAL_MERGE_COUNT" -eq 0 ] && git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
    if [ "$DRY_RUN" -eq 1 ]; then
        MERGE_TREE=$(git merge-tree --write-tree "$REMOTE_SHA" "$LOCAL_SHA" 2>&1) || {
            echo "error: merge preview failed: $MERGE_TREE" >&2
            exit 2
        }
        echo "Dry-run: fast-forward $LOCAL_COMMIT_COUNT commit(s) to $REMOTE/$TRUNK (tree $MERGE_TREE); no changes made"
        exit 0
    fi
    PUSH_OUTPUT=$(mktemp)
    PUSH_TRACE=$(mktemp)
    if push_with_output "$PUSH_OUTPUT" "$PUSH_TRACE" "$REMOTE" "$TRUNK"; then
        rm -f "$PUSH_OUTPUT" "$PUSH_TRACE"
        echo "✓ Fast-forward pushed $LOCAL_COMMIT_COUNT commit(s) to $REMOTE/$TRUNK"
        exit 0
    fi
    push_failure_or_retry_race "$PUSH_OUTPUT" "$PUSH_TRACE" 1 "$REMOTE_SHA"
    status=$?
    if [ "$status" -ne 0 ]; then
        rm -f "$PUSH_OUTPUT" "$PUSH_TRACE"
        exit "$status"
    fi
    rm -f "$PUSH_OUTPUT" "$PUSH_TRACE"
    echo "  (remote advanced during direct push; falling back to squash path)" >&2
fi

echo "  Squashing $LOCAL_COMMIT_COUNT local commit(s) onto $REMOTE/$TRUNK..." >&2

# Compute the merged tree off-tree (no working directory mutation)
MERGE_OUTPUT=$(git merge-tree --write-tree "$REMOTE_SHA" "$LOCAL_SHA" 2>&1) || {
    # Parse conflict info
    CONFLICTS=$(echo "$MERGE_OUTPUT" | grep "^CONFLICT " | sed 's/^CONFLICT /  /')
    echo "error: merge conflict detected" >&2
    if [ -n "$CONFLICTS" ]; then
        echo "Conflicting paths:" >&2
        echo "$CONFLICTS" >&2
    fi
    echo "" >&2
    echo "Resolution: Commits remain local. Resolve conflict and retry." >&2
    exit 1
}

MERGE_TREE="$MERGE_OUTPUT"
if [ "$DRY_RUN" -eq 1 ]; then
    echo "Dry-run: squash $LOCAL_COMMIT_COUNT commit(s) onto $REMOTE/$TRUNK (tree $MERGE_TREE); no changes made"
    exit 0
fi

# Rebuild from the current source range on every attempt: a competing push may
# publish some local commits, changing both the summary and the session set.
build_commit_message() {
    local subjects session_ids
    LOCAL_COMMIT_COUNT=$(git rev-list --count --no-merges "$REMOTE_SHA".."$LOCAL_SHA") || return 1
    subjects=$(git log --reverse --no-merges --format="  %s" "$REMOTE_SHA".."$LOCAL_SHA") || return 1
    # Git parses only the actual trailer block, excluding body examples. Include
    # plural provenance from earlier squashes and deduplicate in source order.
    session_ids=$(git log --reverse \
        --format='%(trailers:key=Git-Session-Id,key=Git-Session-Ids,valueonly,unfold)' \
        "$REMOTE_SHA".."$LOCAL_SHA" | awk '
        BEGIN { FS = "[,[:space:]]+" }
        { for (i = 1; i <= NF; i++) {
            if ($i != "" && !seen[$i]++) {
                printf "%s%s", separator, $i
                separator = ", "
            }
        } }
    ') || return 1
    COMMIT_MSG="sync: squash $LOCAL_COMMIT_COUNT local commit(s) to $REMOTE/$TRUNK

Squashed due to accumulated auto-sync merge commits blocking linear push.
Local commits are preserved in git reflog.

$(echo "$subjects" | head -10)"
    if [ "$LOCAL_COMMIT_COUNT" -gt 10 ]; then
        COMMIT_MSG="$COMMIT_MSG
  ... and $((LOCAL_COMMIT_COUNT - 10)) more"
    fi
    if [ -n "$session_ids" ]; then
        COMMIT_MSG="$COMMIT_MSG

Git-Session-Ids: $session_ids"
    fi
}

build_commit_message || {
    echo "error: failed to collect squash commit metadata" >&2
    exit 2
}

# Create a squash (linear) commit with only REMOTE_SHA as parent (no merge commits)
SQUASH_COMMIT=$(git commit-tree \
    -p "$REMOTE_SHA" \
    -m "$COMMIT_MSG" \
    "$MERGE_TREE" 2>/dev/null) || {
    echo "error: failed to create squash commit" >&2
    exit 2
}

# Push WITHOUT updating the local trunk first (push-then-update, not update-then-push)
# Retry loop: if the remote races ahead between our fetch and push, refetch + recompute and retry.
# On a hot day with many concurrent sessions, non-fast-forward rejections are transient races
# (not real errors) and should be retried, not reported as exit 2.
MAX_PUSH_RETRIES=3
PUSH_ATTEMPT=0
while [ "$PUSH_ATTEMPT" -lt "$MAX_PUSH_RETRIES" ]; do
    PUSH_ATTEMPT=$((PUSH_ATTEMPT + 1))
    PUSH_OUTPUT=$(mktemp)
    PUSH_TRACE=$(mktemp)
    if push_with_output "$PUSH_OUTPUT" "$PUSH_TRACE" "$REMOTE" "${SQUASH_COMMIT}:refs/heads/$TRUNK"; then
        rm -f "$PUSH_OUTPUT" "$PUSH_TRACE"
        break  # success — fall through to update-ref below
    fi
    push_failure_or_retry_race "$PUSH_OUTPUT" "$PUSH_TRACE" "$PUSH_ATTEMPT" "$REMOTE_SHA"
    status=$?
    if [ "$status" -ne 0 ]; then
        rm -f "$PUSH_OUTPUT" "$PUSH_TRACE"
        exit "$status"
    fi
    rm -f "$PUSH_OUTPUT" "$PUSH_TRACE"
    if [ "$PUSH_ATTEMPT" -ge "$MAX_PUSH_RETRIES" ]; then
        echo "error: $REMOTE/$TRUNK advanced during all $MAX_PUSH_RETRIES push attempts" >&2
        echo "       Local $TRUNK NOT modified. Retry git-safe-push-master." >&2
        exit 2
    fi
    sleep "${GIT_SAFE_PUSH_RETRY_SLEEP:-$((PUSH_ATTEMPT * 2))}"
    if [ "$LOCAL_SHA" = "$REMOTE_SHA" ]; then
        echo "✓ Already in sync with $REMOTE/$TRUNK (after retry)"
        exit 0
    fi
    REMAINING=$(git log --no-merges --format="%H" "$REMOTE_SHA".."$LOCAL_SHA" | wc -l)
    if [ "$REMAINING" -eq 0 ]; then
        # Our commits were already published by a sibling session in their squash
        git update-ref "refs/heads/$TRUNK" "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null || true
        echo "✓ Commits already published by sibling session (after retry)"
        exit 0
    fi
    MERGE_TREE=$(git merge-tree --write-tree "$REMOTE_SHA" "$LOCAL_SHA" 2>&1) || {
        echo "error: merge conflict on retry $PUSH_ATTEMPT" >&2
        exit 1
    }
    build_commit_message || {
        echo "error: failed to collect squash commit metadata on retry $PUSH_ATTEMPT" >&2
        exit 2
    }
    SQUASH_COMMIT=$(git commit-tree -p "$REMOTE_SHA" -m "$COMMIT_MSG" "$MERGE_TREE" 2>/dev/null) || {
        echo "error: failed to create squash commit on retry $PUSH_ATTEMPT" >&2
        exit 2
    }
done

# Push succeeded: update the local trunk to the squash commit (removes accumulated merge commits)
if ! git update-ref "refs/heads/$TRUNK" "$SQUASH_COMMIT" "$LOCAL_SHA" 2>/dev/null; then
    echo "warning: pushed OK but failed to update local $TRUNK (concurrent commit?)" >&2
    echo "         Preserve local disk/index state; inspect refs and retry after the concurrent writer finishes." >&2
    exit 0
fi

# Publication already succeeded. Materialization is a separate, best-effort step:
# compare complete index entries and actual filesystem types, not only blob IDs.
# File/directory transitions are checked as a unit so a clean sibling cannot cause
# checkout to remove a dirty descendant. NUL-delimited Git output preserves names.
if ! python3 - "$LOCAL_SHA" "$SQUASH_COMMIT" <<'PY'
import os
import stat
import subprocess
import sys


def git(*args, **kwargs):
    return subprocess.check_output(["git", *args], **kwargs)


def within(path, root):
    return path == root or path.startswith(root + b"/")


def tree(revision):
    entries = {}
    for record in git("ls-tree", "-rz", revision).split(b"\0"):
        if record:
            metadata, path = record.split(b"\t", 1)
            mode, _, oid = metadata.split()
            entries[path] = (mode, oid)
    return entries


def main():
    os.chdir(os.fsdecode(git("rev-parse", "--show-toplevel")[:-1]))
    before, after = sys.argv[1:]
    old, new = tree(before), tree(after)
    index = {}
    for record in git("ls-files", "--stage", "-z").split(b"\0"):
        if record:
            metadata, path = record.split(b"\t", 1)
            mode, oid, stage = metadata.split()
            index.setdefault(path, []).append((mode, oid, stage))
    flagged = set()
    for record in git("ls-files", "-v", "-z").split(b"\0"):
        if record and record[:1] != b"H":
            flagged.add(record[2:])

    changed = set(filter(None, git(
        "diff", "--no-renames", "--name-only", "-z", before, after
    ).split(b"\0")))
    roots = set()
    for path in changed:
        # A tracked leaf in either tree can replace a directory in the other.
        ancestors = path.split(b"/")
        root = path
        for length in range(1, len(ancestors)):
            ancestor = b"/".join(ancestors[:length])
            if ancestor in old or ancestor in new:
                root = ancestor
                break
        roots.add(root)
    roots = {root for root in roots if not any(
        other != root and within(root, other) for other in roots
    )}

    def disk_matches(path, expected):
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            return not expected
        if not expected:
            # Includes untracked/ignored files, dangling symlinks and directories.
            return False
        if path in expected:
            mode, oid = expected[path]
            if mode == b"120000" and stat.S_ISLNK(info.st_mode):
                actual = git("hash-object", "--stdin", input=os.readlink(path)).strip()
            elif mode in (b"100644", b"100755") and stat.S_ISREG(info.st_mode):
                executable = bool(info.st_mode & 0o111)
                if executable != (mode == b"100755"):
                    return False
                # Raw bytes only: clean filters/line-ending normalization can
                # hide a session edit, and running filters can have side effects.
                actual = git("hash-object", "--no-filters", "--", path).strip()
            else:
                # Never traverse symlinks, submodules or special files.
                return False
            return actual == oid
        if not stat.S_ISDIR(info.st_mode):
            return False
        children = {entry.split(b"/", 1)[0] for entry in (
            name[len(path) + 1:] for name in expected if within(name, path)
        )}
        if set(os.listdir(path)) != children:
            return False
        return all(disk_matches(path + b"/" + child, expected) for child in children)

    materialized = skipped = failed = 0
    for root in sorted(roots):
        expected = {path: entry for path, entry in old.items() if within(path, root)}
        expected_index = {path: [(mode, oid, b"0")]
                          for path, (mode, oid) in expected.items()}
        actual_index = {path: entries for path, entries in index.items() if within(path, root)}
        unsupported = any(mode not in (b"100644", b"100755", b"120000")
                          for entries in (old, new) for path, (mode, _) in entries.items()
                          if within(path, root))
        try:
            # An untracked symlink/file in an ancestor must not redirect checkout.
            parts = root.split(b"/")
            ancestors_clean = True
            for length in range(1, len(parts)):
                ancestor = b"/".join(parts[:length])
                if (ancestor in index or ancestor in flagged
                        or (os.path.lexists(ancestor)
                            and not stat.S_ISDIR(os.lstat(ancestor).st_mode))):
                    ancestors_clean = False
                    break
            if (unsupported or actual_index != expected_index
                    or any(within(path, root) for path in flagged)
                    or not ancestors_clean or not disk_matches(root, expected)):
                skipped += 1
                continue
            # Literal root includes all leaves of a type transition. Unlike
            # checkout, restore also handles paths deleted from the source tree.
            subprocess.run(["git", "restore", "--source", after, "--staged",
                            "--worktree", "--", b":(literal)" + root], check=True)
            materialized += 1
        except (OSError, subprocess.CalledProcessError) as error:
            failed += 1
            print(f"warning: materialization failed/potentially partial for "
                  f"{os.fsdecode(root)!r}: {error}; stopping further restores",
                  file=sys.stderr)
            break
    unattempted = len(roots) - materialized - skipped - failed
    print(f"  Local materialization: {materialized} clean group(s) updated, "
          f"{skipped} locally changed/unsupported skipped, {failed} failed, "
          f"{unattempted} unattempted")
    if skipped or failed:
        print("warning: publication succeeded; skipped/failed local paths remain unreconciled. "
              "Inspect disk/index before any path-scoped recovery; never reset the shared worktree.",
              file=sys.stderr)
    return bool(failed)


try:
    sys.exit(main())
except (OSError, subprocess.CalledProcessError) as error:
    print(f"warning: local materialization could not complete: {error}", file=sys.stderr)
    sys.exit(1)
PY
then
    echo "warning: push succeeded but local materialization was incomplete; inspect disk/index separately." >&2
fi

MERGE_SKIPPED=$((LOCAL_MERGE_COUNT + 0))
echo "✓ Published $(git rev-parse --short "$SQUASH_COMMIT" 2>/dev/null) to $REMOTE/$TRUNK"
echo "  Squashed $LOCAL_COMMIT_COUNT commit(s)$([ "$MERGE_SKIPPED" -gt 0 ] && echo " (skipped $MERGE_SKIPPED local merge commit(s))" || true)"

exit 0
