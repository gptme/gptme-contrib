#!/usr/bin/env bash
# git-safe-pull: bring the remote's commits into a shared worktree without ever
# stashing, rebasing, or creating a merge commit.
#
# Why this exists
# ---------------
# In a shared "hot" worktree where many concurrent sessions edit and commit at
# once, the commit and push paths are already off-tree:
#   - git-safe-commit runs hooks against a PRIVATE index outside the flock and
#     takes the lock only for the index mutation.
#   - git-safe-push-master reconciles with the remote off-tree and never touches
#     the working tree.
# The pull path was the last on-tree git operation, and it has two real defects
# that this script exists to close (NOT autostash — autostash is precisely what
# silently eats uncommitted files in a shared worktree and must never be used):
#   1. WRONG LOCK. A pull that serializes on a private lock (not the shared
#      commit lock) can move the worktree while a sibling session is mid-commit.
#      That race is the clobber window.
#   2. DIRTY TREES NEVER PULLED. With many concurrent sessions the tree is almost
#      always dirty, so a fetch-only fallback leaves sessions on stale files
#      indefinitely.
#
# The guarantee: this script only ever fast-forwards. `git merge --ff-only`
# refuses rather than overwriting modified files, and we never stash, so there is
# no pop to drop and nothing to orphan. If it cannot fast-forward, it stops and
# tells you what to run.
#
# It also takes the SAME flock as git-safe-commit for the brief moment it moves
# the worktree. A sibling's tree-moving pull racing another session's commit is
# the clobber window; serializing them on one lock closes it.
#
# Usage: git-safe-pull [--remote <name>] [--branch <name>] [--quiet]
#
# Exit codes:
#   0 = up to date, fast-forwarded, or ahead-only (nothing to pull)
#   1 = blocked (would overwrite local changes, or history diverged)
#   2 = error (not a repo, detached HEAD, fetch failed, lock timeout)

set -uo pipefail

REMOTE=""
BRANCH=""
QUIET=0
while [ $# -gt 0 ]; do
    case "$1" in
    --remote)
        REMOTE="${2:-}"
        shift 2
        ;;
    --branch)
        BRANCH="${2:-}"
        shift 2
        ;;
    --quiet)
        QUIET=1
        shift
        ;;
    -h | --help)
        sed -n '1,36p' "$0"
        exit 0
        ;;
    *)
        echo "error: unknown argument: $1" >&2
        exit 2
        ;;
    esac
done

say() { [ "$QUIET" = 1 ] || echo "$@"; }

GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)" || {
    echo "error: not in a git repository" >&2
    exit 2
}

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ -z "$CURRENT_BRANCH" ] || [ "$CURRENT_BRANCH" = "HEAD" ]; then
    echo "error: detached HEAD — refusing to pull (checkout a branch first)" >&2
    exit 2
fi

[ -n "$BRANCH" ] || BRANCH="$CURRENT_BRANCH"
[ -n "$REMOTE" ] || REMOTE="$(git config --get "branch.$BRANCH.remote" 2>/dev/null || echo origin)"

# Resolve the actual remote tracking branch name — it may differ from the
# local branch name. Example: a local "feature" branch created with
# `git checkout -b feature --track origin/master` has
#   branch.feature.merge = refs/heads/master
# so we must fetch "master" from origin, not "feature".
REMOTE_REF="$(git config --get "branch.$BRANCH.merge" 2>/dev/null | sed 's|refs/heads/||')"
[ -n "$REMOTE_REF" ] || REMOTE_REF="$BRANCH"

if ! git config --get "remote.$REMOTE.url" >/dev/null 2>&1; then
    echo "error: no such remote: $REMOTE" >&2
    exit 2
fi

# --- Fetch. Read-only with respect to the working tree; always safe. ---
if ! git fetch --quiet "$REMOTE" "$REMOTE_REF" 2>/dev/null; then
    echo "error: fetch failed ($REMOTE $REMOTE_REF)" >&2
    exit 2
fi

LOCAL="$(git rev-parse HEAD 2>/dev/null)" || {
    echo "error: could not resolve HEAD" >&2
    exit 2
}
REMOTE_SHA="$(git rev-parse "$REMOTE/$REMOTE_REF" 2>/dev/null)" || {
    echo "error: could not resolve $REMOTE/$REMOTE_REF" >&2
    exit 2
}

if [ "$LOCAL" = "$REMOTE_SHA" ]; then
    say "✓ already in sync with $REMOTE/$REMOTE_REF"
    exit 0
fi

BASE="$(git merge-base "$LOCAL" "$REMOTE_SHA" 2>/dev/null)" || {
    echo "error: no common ancestor with $REMOTE/$REMOTE_REF" >&2
    exit 2
}

# --- Ahead only: nothing to pull. Publishing is a different tool's job. ---
if [ "$BASE" = "$REMOTE_SHA" ]; then
    ahead="$(git rev-list --count "$REMOTE_SHA..$LOCAL" 2>/dev/null || echo '?')"
    say "✓ nothing to pull — $ahead local commit(s) not yet published"
    say "  publish with: git-safe-push-master"
    exit 0
fi

# --- Diverged: a pull here would mean a rebase or a merge commit. Refuse. ---
if [ "$BASE" != "$LOCAL" ]; then
    ahead="$(git rev-list --count "$REMOTE_SHA..$LOCAL" 2>/dev/null || echo '?')"
    behind="$(git rev-list --count "$LOCAL..$REMOTE_SHA" 2>/dev/null || echo '?')"
    cat >&2 <<EOF
🚫 Refusing to pull: history has diverged ($ahead ahead, $behind behind).

Reconciling here would need a rebase (its autostash is what silently eats
uncommitted files in this shared worktree) or a merge commit (which the remote's
ruleset may reject on the trunk, jamming every session's push).

Publish your local commits off-tree first, then pull:

    git-safe-push-master && git-safe-pull

git-safe-push-master reconciles against the remote without touching this working
tree, so it is safe while sibling sessions are mid-edit. Once your commits are
published, this pull becomes a plain fast-forward.
EOF
    exit 1
fi

# --- Behind only: a fast-forward is possible. Check what would block it. ---
behind="$(git rev-list --count "$LOCAL..$REMOTE_SHA" 2>/dev/null || echo '?')"

# git merge --ff-only refuses rather than clobbering, but a bare "would be
# overwritten" error does not say which of the fleet's many dirty paths is at
# fault. Name them up front so the message is actionable.
incoming="$(git diff --name-only "$LOCAL" "$REMOTE_SHA" 2>/dev/null || true)"
if [ -n "$incoming" ]; then
    blockers=""
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        # Dirty (modified/staged) or an untracked file the merge would overwrite.
        if [ -n "$(git status --porcelain -- "$f" 2>/dev/null)" ]; then
            blockers+="  $f"$'\n'
        fi
    done <<<"$incoming"
    if [ -n "$blockers" ]; then
        echo "🚫 Refusing to pull: $REMOTE/$REMOTE_REF changes files that are dirty here:" >&2
        printf '%s' "$blockers" >&2
        cat >&2 <<'EOF'
Nothing was stashed and nothing was moved — your working tree is untouched.

Commit your version first, then pull:

    git-safe-commit --scope-only <those paths> -m "..."
    git-safe-pull

If the dirty copy is a sibling session's in-flight work, leave it alone and
retry in a few minutes.
EOF
        exit 1
    fi
fi

# --- Fast-forward under the shared commit lock. ---
# A tree-moving pull racing a sibling's commit is the clobber window; the lock is
# the same one git-safe-commit and git-safe-push-master serialize on.
LOCKFILE="$GIT_DIR/commit.lock"
LOCK_TIMEOUT="${GIT_SAFE_PULL_LOCK_TIMEOUT:-60}"
case "$LOCK_TIMEOUT" in
*[!0-9]* | '')
    echo "error: GIT_SAFE_PULL_LOCK_TIMEOUT must be a positive integer" >&2
    exit 2
    ;;
esac

exec 9>"$LOCKFILE" || {
    echo "error: could not open lock file: $LOCKFILE" >&2
    exit 2
}
if ! flock --timeout "$LOCK_TIMEOUT" 9; then
    echo "error: timed out waiting for the commit lock (${LOCK_TIMEOUT}s)" >&2
    echo "hint: another session is committing; retry shortly" >&2
    exit 2
fi

# HEAD can move between the fetch and the lock — re-verify rather than acting on
# a stale read. If it moved, bail and let the caller re-run against fresh state.
NOW_HEAD="$(git rev-parse HEAD 2>/dev/null || true)"
if [ "$NOW_HEAD" != "$LOCAL" ]; then
    echo "note: HEAD moved while waiting for the lock — re-run git-safe-pull" >&2
    exit 1
fi

if ! ff_output="$(git merge --ff-only "$REMOTE_SHA" 2>&1)"; then
    echo "🚫 fast-forward refused by git (working tree untouched, nothing stashed):" >&2
    printf '%s\n' "$ff_output" >&2
    exit 1
fi

say "✓ fast-forwarded $behind commit(s) from $REMOTE/$REMOTE_REF"
exit 0
