#!/usr/bin/env python3
"""Append Git-Session-Id, recovering scrubbed environments within a cgroup.

Replaces the env-only bash hook. Subagents, worktrees, and systemd-run
children often lose GIT_COMMITTER_SESSION_ID; walking same-cgroup ancestors
recovers it. Agent-neutral: AGENT_* first, BOB_* kept as compatibility.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from collections.abc import Iterable
from pathlib import Path

DIRECT_KEYS = (
    "GIT_COMMITTER_SESSION_ID",
    "AGENT_SESSION_ID",
    "GIT_SAFE_COMMIT_SESSION_ID",
    "BOB_SESSION_ID",
)
HARNESS_KEYS = ("CC_SESSION_ID", "CLAUDE_CODE_SESSION_ID")
SESSION_FIELDS = ("agent_session_id", "bob_session_id")
IDENTITY_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}")


def _default_state_dirs(env: dict[str, str]) -> list[Path]:
    tmp = Path(env.get("TMPDIR", "/tmp"))
    return [tmp / "agent-provenance-state", tmp / "bob-provenance-state"]


def identity_from_env(
    env: dict[str, str],
    state_dirs: Iterable[Path],
) -> str | None:
    for key in DIRECT_KEYS:
        value = env.get(key, "").strip()
        if IDENTITY_RE.fullmatch(value):
            return value
    for key in HARNESS_KEYS:
        value = env.get(key, "").strip()
        if not IDENTITY_RE.fullmatch(value):
            continue
        for state_dir in state_dirs:
            try:
                state = json.loads((state_dir / f"{value}.json").read_text())
            except (OSError, ValueError):
                continue
            if not isinstance(state, dict):
                continue
            for field in SESSION_FIELDS:
                mapped = state.get(field)
                if isinstance(mapped, str) and IDENTITY_RE.fullmatch(mapped):
                    return mapped
    return None


def resolve_session_id(
    env: dict[str, str],
    proc_root: Path = Path("/proc"),
    state_dir: Path | None = None,
    pid: int | None = None,
) -> str | None:
    state_dirs = [state_dir] if state_dir is not None else _default_state_dirs(env)
    identity = identity_from_env(env, state_dirs)
    if identity:
        return identity
    # Unit names identify reusable lanes, not sessions. Only inspect ancestors
    # in the same cgroup; never infer authorship from another process in the lane.
    pid = os.getpid() if pid is None else pid
    try:
        cgroup = (proc_root / str(pid) / "cgroup").read_text()
    except OSError:
        return None
    if not cgroup.strip():
        return None
    seen: set[int] = set()
    for _ in range(64):
        if pid <= 1 or pid in seen:
            break
        seen.add(pid)
        try:
            # comm may contain spaces and parentheses; fields after ')' start
            # with state, then PPID (proc_pid_stat(5)).
            stat = (proc_root / str(pid) / "stat").read_text()
            pid = int(stat.rsplit(")", 1)[1].split()[1])
            parent = proc_root / str(pid)
            # PID 1 may be the agent in a container. Inspect it once before
            # the next loop iteration terminates, still enforcing the cgroup.
            if pid < 1 or (parent / "cgroup").read_text() != cgroup:
                break
            entries = (
                (parent / "environ").read_bytes().decode(errors="replace").split("\0")
            )
        except (OSError, ValueError, IndexError):
            break
        parent_env = dict(entry.split("=", 1) for entry in entries if "=" in entry)
        parent_state_dirs = (
            [state_dir] if state_dir is not None else _default_state_dirs(parent_env)
        )
        identity = identity_from_env(parent_env, parent_state_dirs)
        if identity:
            return identity
    return None


def _opted_out(env: dict[str, str]) -> bool:
    return env.get("AGENT_SESSION_TRAILER", "1").strip().lower() in {
        "0",
        "false",
        "no",
        "off",
    }


def main() -> int:
    if _opted_out(dict(os.environ)):
        return 0
    if len(sys.argv) < 2 or not Path(sys.argv[1]).is_file():
        return 0
    message = sys.argv[1]
    trailers = subprocess.check_output(
        ["git", "interpret-trailers", "--parse", message]
    )
    if any(
        line.partition(b":")[0].lower() in (b"git-session-id", b"git-session-ids")
        for line in trailers.splitlines()
    ):
        return 0
    identity = resolve_session_id(dict(os.environ))
    if identity:
        # Merge --no-edit messages may omit the final newline. Terminate the
        # subject so interpret-trailers creates a parseable trailer paragraph.
        with Path(message).open("rb+") as stream:
            content = stream.read()
            if content and not content.endswith(b"\n"):
                stream.write(b"\n")
        subprocess.run(
            [
                "git",
                "interpret-trailers",
                "--in-place",
                "--if-exists",
                "doNothing",
                "--if-missing",
                "add",
                "--trailer",
                f"Git-Session-Id: {identity}",
                message,
            ],
            check=True,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
