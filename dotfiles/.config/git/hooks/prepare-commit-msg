#!/usr/bin/env bash
# Append a Git-Session-Id trailer when the session id is available in the env.

set -euo pipefail

MSG_FILE="${1:-}"
SESSION_ID="${GIT_COMMITTER_SESSION_ID:-}"

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ] || [ -z "$SESSION_ID" ]; then
    exit 0
fi

if git interpret-trailers --parse "$MSG_FILE" | grep -qi '^Git-Session-Id: '; then
    exit 0
fi

# `git merge --no-edit` (and `git pull` merges) write the message without a
# trailing newline; interpret-trailers then glues the trailer onto the subject
# line, where `%(trailers)` / `--parse` cannot see it. Terminate the last line.
if [ -s "$MSG_FILE" ] && [ -n "$(tail -c1 "$MSG_FILE")" ]; then
    printf '\n' >>"$MSG_FILE"
fi

git interpret-trailers \
    --in-place \
    --if-exists doNothing \
    --if-missing add \
    --trailer "Git-Session-Id: $SESSION_ID" \
    "$MSG_FILE"
