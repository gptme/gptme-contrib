#!/bin/bash
# Pre-push hook: mass-deletion guard, force-reset guard, branch protection, worktree validation
#
# Install globally:
#   git config --global core.hooksPath ~/.config/git/hooks

set -euo pipefail

SCRIPT_DIR="$(dirname "$0")"
# Config files sit next to the *installed* hooks dir. install.sh symlinks
# $HOME/.config/git/hooks into the shared dotfiles checkout, and ".." through a
# symlink is resolved by the kernel against the link target — so derive the
# config dir textually, and the agent's own allowed-repos.conf is read instead
# of the shared checkout's template copy (see pre-commit for the full note).
HOOK_CONF_DIR="$(dirname "$SCRIPT_DIR")"
_read_hook_conf() {
    # Sourced in a subshell and serialized back with `declare -p`, so a stray
    # `exit` in a hand-edited conf cannot terminate this hook and skip the
    # guards below it (see pre-commit for the full note).
    local name="$1" var="$2"
    local _serialized
    _serialized="$(
        set +e
        # shellcheck source=/dev/null
        source "$HOOK_CONF_DIR/$name"
        declare -p "$var" 2>/dev/null || exit 1
    )" || return 1
    [ -n "$_serialized" ] || return 1
    eval "${_serialized/#declare -a/declare -ga}" || return 1
    return 0
}

# Git invokes: pre-push <remote-name> <remote-url>
# Used to skip origin-specific work when pushing to a mirror or other remote.
PUSH_REMOTE_NAME="${1:-}"

# Normalise a remote URL to a canonical identity string so aliases (HTTPS/SSH
# variants, hostname case, .git suffix) compare equal. Repository path case is
# preserved except on GitHub, where repository names are case-insensitive. Unknown shapes
# return a non-empty but distinct string, so callers fail closed.
_canonical_remote_url() {
    local url="$1" file_path="" decoded="" byte
    # Local file URLs share filesystem identity with plain paths. Decode URL
    # escapes once (not shell escapes), preserving case and the .git suffix.
    case "$url" in
        file:///*) file_path="${url#file://}" ;;
        file://localhost/*) file_path="${url#file://localhost}" ;;
    esac
    if [ -n "$file_path" ]; then
        while [[ "$file_path" =~ ^([^%]*)%([[:xdigit:]]{2})(.*)$ ]]; do
            # NUL is not a filesystem byte and cannot be represented in Bash.
            [ "${BASH_REMATCH[2]}" = "00" ] && { printf '%s\n' "$url"; return; }
            printf -v byte '%b' "\\x${BASH_REMATCH[2]}"
            decoded+="${BASH_REMATCH[1]}${byte}"
            file_path="${BASH_REMATCH[3]}"
        done
        url="${decoded}${file_path}"
        realpath -m -- "$url" 2>/dev/null || printf '%s\n' "$url"
        return
    fi
    # Git also accepts bare relative paths (repo.git). Keep filesystem identity
    # separate from network URL normalization: local paths are case-sensitive.
    case "$url" in
        "") return ;;
        /*|./*|../*) realpath -m -- "$url" 2>/dev/null || printf '%s\n' "$url"; return ;;
        *://*|*:*) ;;
        *) realpath -m -- "$url" 2>/dev/null || printf '%s\n' "$url"; return ;;
    esac
    # SCP paths without a leading slash are relative to the SSH user's home,
    # unlike ssh://host/path and host:/path. GitHub's hosted repository names
    # are the established exception shared by HTTPS and SSH spellings.
    if [[ "$url" != *://* && "$url" =~ ^([^/:]+):([^/].*)$ ]]; then
        local scp_authority="${BASH_REMATCH[1]}" scp_path="${BASH_REMATCH[2]}"
        local scp_host="${scp_authority##*@}" scp_user=""
        if [[ "$scp_authority" == *@* ]]; then
            scp_user="${scp_authority%@*}@"
        fi
        case "${scp_host,,}" in
            github.com|ssh.github.com) ;;
            *)
                scp_path="${scp_path%/}"
                printf 'scp-home:%s%s/%s\n' "$scp_user" "${scp_host,,}" "${scp_path%.git}"
                return
                ;;
        esac
    fi
    printf '%s\n' "$url" | sed -E \
        -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://([^@/]+@)?##' \
        -e 's#^[^/@:]+@##' \
        -e 's#^([^/:]+):(22|443)(/|$)#\1\3#' \
        -e 's#^([^/:]+):/?#\1/#' \
        -e 's#^[^/]+@##' \
        -e 's#/$##' \
        -e 's#\.git$##' | awk '
            {
                slash = index($0, "/")
                host = slash ? substr($0, 1, slash - 1) : $0
                path = slash ? substr($0, slash) : ""
                host = tolower(host)
                if (host == "ssh.github.com") host = "github.com"
                if (host == "github.com") path = tolower(path)
                print host path
            }'
}

# Read stdin before any subprocess consumes it.
# Git provides per line: local_ref local_sha remote_ref remote_sha
# The `|| [ -n "$local_ref" ]` handles the last line without a trailing newline
# (e.g. when stdin comes from Python subprocess or echo without -n).
STDIN_LINES=()
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
    STDIN_LINES+=("$local_ref $local_sha $remote_ref $remote_sha")
done

# --- Mass-deletion guard (per-commit scan) ---
# Scans every commit in the push range for catastrophic deletions.
# This is the LAST line of defense before bad commits reach the remote.
# Bypass: ALLOW_MASS_DELETE=1 git push ...
ZERO="0000000000000000000000000000000000000000"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
_GUARD_SCRIPT=""
if [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/scripts/git/guard-mass-delete.sh" ]; then
    _GUARD_SCRIPT="$REPO_ROOT/scripts/git/guard-mass-delete.sh"
elif [ -n "$SCRIPT_DIR" ]; then
    _GPTME_CONTRIB_DIR="$(cd "$SCRIPT_DIR/../../../.." 2>/dev/null && pwd)"
    if [ -f "$_GPTME_CONTRIB_DIR/scripts/git/guard-mass-delete.sh" ]; then
        _GUARD_SCRIPT="$_GPTME_CONTRIB_DIR/scripts/git/guard-mass-delete.sh"
    fi
fi
if [ -n "$_GUARD_SCRIPT" ]; then
    # shellcheck source=../../../scripts/git/guard-mass-delete.sh
    source "$_GUARD_SCRIPT"

    # Build the per-remote exclusion list once (the push destination is constant
    # across all refs in one invocation).  Exclude only remotes whose push URL
    # differs from the destination so that:
    #  - a stale tracking ref on the destination itself never hides a destructive
    #    commit from the scan (the core P1 fix), and
    #  - a URL alias of the destination is treated the same as its canonical name.
    #
    # Use argv[2] (the URL git supplies) as the identity source: it works even
    # when the caller pushes to a bare URL instead of a configured remote name
    # (in which case git remote get-url would fail).
    _other_remote_prefixes=()
    _other_fetch_patterns=()
    _protected_ref_prefixes=()
    _protected_fetch_patterns=()
    _protect_remote_refs() {
        local remote="$1" spec destination
        _protected_ref_prefixes+=("refs/remotes/${remote}/")
        # Tracking refs need not live under the remote's name. Protect every
        # configured fetch destination too, including exact and wildcard maps.
        # Ignore negative/source-only refspecs: neither writes a local ref.
        while IFS= read -r spec; do
            [[ "$spec" == ^* || "$spec" != *:* ]] && continue
            destination="${spec#*:}"
            if [ -n "$destination" ]; then
                _protected_fetch_patterns+=("$destination")
            fi
        done < <(git config --get-all "remote.${remote}.fetch" 2>/dev/null)
    }
    _dest_push_url="${2:-}"
    if [ -z "$_dest_push_url" ] && [ -n "$PUSH_REMOTE_NAME" ]; then
        _dest_push_url="$(git remote get-url --push "$PUSH_REMOTE_NAME" 2>/dev/null || true)"
    fi
    _dest_push_identity="$(_canonical_remote_url "$_dest_push_url")"
    # When pushing by bare URL, PUSH_REMOTE_NAME is the URL itself and
    # refs/remotes/<url>/ does not exist. Track the configured remote name
    # (if any) whose fetch AND push URLs match the destination so the new-branch
    # path can use its tracking history for for-each-ref range scoping.
    _dest_remote_name=""
    _dest_name_matched="false"   # true when PUSH_REMOTE_NAME matched a configured name
    _dest_url_alias=""           # first URL alias (used only when no name match)
    while IFS= read -r _r; do
        # Skip by name — record that we found the configured destination remote
        # so URL aliases below do not override it even if they appear first.
        if [ "$_r" = "$PUSH_REMOTE_NAME" ]; then
            _dest_name_matched="true"
            _r_fetch_url="$(git remote get-url "$_r" 2>/dev/null || true)"
            if [ "$(_canonical_remote_url "$_r_fetch_url")" = "$_dest_push_identity" ]; then
                _dest_remote_name="$_r"
            fi
            _protect_remote_refs "$_r"
            continue
        fi
        # Skip URL aliases of the push destination and remotes that FETCH from
        # the same repository. Tracking refs describe what was fetched, not
        # where pushes land. A remote whose fetch URL matches the destination
        # can have a stale tracking ref pointing to a destructive commit we are
        # about to re-push — the same bypass the dest-tracking-ref fix closed.
        if [ -n "$_dest_push_identity" ]; then
            _r_push_matches=false
            while IFS= read -r _r_push_url; do
                _r_push_identity="$(_canonical_remote_url "$_r_push_url")"
                if [ "$_r_push_identity" = "$_dest_push_identity" ]; then
                    _r_push_matches=true
                    break
                fi
            done < <(git remote get-url --push --all "$_r" 2>/dev/null)
            if [ "$_r_push_matches" = true ]; then
                # A push alias protects refs, but only a matching FETCH
                # endpoint can supply destination history as a baseline.
                _r_fetch_url="$(git remote get-url "$_r" 2>/dev/null || true)"
                if [ "$(_canonical_remote_url "$_r_fetch_url")" = "$_dest_push_identity" ]; then
                    [ -z "$_dest_url_alias" ] && _dest_url_alias="$_r"
                fi
                _protect_remote_refs "$_r"
                continue
            fi
            _r_fetch_url="$(git remote get-url "$_r" 2>/dev/null || true)"
            _r_fetch_identity="$(_canonical_remote_url "$_r_fetch_url")"
            if [ "$_r_fetch_identity" = "$_dest_push_identity" ]; then
                _protect_remote_refs "$_r"
                continue
            fi
        fi
        _other_remote_prefixes+=("refs/remotes/${_r}/")
        while IFS= read -r _spec; do
            [[ "$_spec" == ^* || "$_spec" != *:* ]] && continue
            _target="${_spec#*:}"
            if [ -n "$_target" ]; then
                _other_fetch_patterns+=("$_target")
            fi
        done < <(git config --get-all "remote.${_r}.fetch" 2>/dev/null)
    done < <(git remote 2>/dev/null)
    # --remotes=team recursively includes team/fork. Expand to explicit refs,
    # then conservatively retain every destination/alias namespace in the scan,
    # even when another remote's prefix overlaps it. Snapshot object IDs in the
    # same enumeration so a concurrent fetch/prune cannot invalidate exclusions.
    _other_remotes=""
    while read -r _ref _oid; do
        _protected=false
        for _prefix in "${_protected_ref_prefixes[@]}"; do
            if [[ "$_ref" == "$_prefix"* ]]; then
                _protected=true
                break
            fi
        done
        for _pattern in "${_protected_fetch_patterns[@]}"; do
            # The unquoted RHS deliberately interprets the refspec's wildcard.
            # shellcheck disable=SC2053
            if [[ "$_ref" == $_pattern ]]; then
                _protected=true
                break
            fi
        done
        [ "$_protected" = true ] && continue
        _other=false
        for _prefix in "${_other_remote_prefixes[@]}"; do
            if [[ "$_ref" == "$_prefix"* ]]; then
                _other=true
                break
            fi
        done
        for _pattern in "${_other_fetch_patterns[@]}"; do
            # shellcheck disable=SC2053
            if [[ "$_ref" == $_pattern ]]; then
                _other=true
                break
            fi
        done
        if [ "$_other" = true ]; then
            _other_remotes="$_other_remotes $_oid"
        fi
    done < <(git for-each-ref --format='%(refname) %(objectname)' refs/ 2>/dev/null)
    # Post-loop: if PUSH_REMOTE_NAME was not matched as a configured name (bare
    # URL push), substitute the first URL alias we found — it carries tracking refs.
    # A named remote with a different fetch endpoint supplies no baseline.
    if [ "$_dest_name_matched" = "false" ] && [ -n "$_dest_url_alias" ]; then
        _dest_remote_name="$_dest_url_alias"
    fi

    # A different remote may fetch into the destination's conventional
    # namespace. Such refs cannot establish destination history merely by name.
    _non_dest_fetch_patterns=()
    while IFS= read -r _r; do
        [ "$_r" = "$_dest_remote_name" ] && continue
        while IFS= read -r _spec; do
            [[ "$_spec" == ^* || "$_spec" != *:* ]] && continue
            _target="${_spec#*:}"
            if [ -n "$_target" ]; then
                _non_dest_fetch_patterns+=("$_target")
            fi
        done < <(git config --get-all "remote.${_r}.fetch" 2>/dev/null)
    done < <(git remote 2>/dev/null)

    for line in "${STDIN_LINES[@]}"; do
        read -r local_ref local_sha remote_ref remote_sha <<< "$line"

        # Skip branch deletions
        [ "$local_sha" = "$ZERO" ] && continue

        # Determine the range of commits being pushed. Skip commits that any
        # non-destination remote-tracking ref already contains: rebasing a fork
        # branch onto upstream master otherwise rescans upstream's own commits,
        # and a landed mass rename (aw-webui's JS->TS migration, 54 files) trips
        # the guard on every fork push.
        #
        # For existing branches we only exclude OTHER remotes' tracking refs, not
        # the push destination's. Its tracking ref may be stale (e.g. after a
        # human force-reset the remote behind this clone's back), and blindly
        # excluding it would hide the destructive commit from the scan.
        if [ "$remote_sha" = "$ZERO" ]; then
            # New branch: no destination tracking ref from git, but the clone may
            # retain a stale one (e.g. if the branch was deleted remotely). Build
            # an exclusion from the destination's OTHER tracking refs (to scope
            # the range to new commits efficiently) but skip this branch's own
            # tracking ref — it may be stale and could hide a destructive commit.
            _branch_name="${remote_ref#refs/heads/}"
            _dest_other_excl=""
            if [ -n "$_dest_remote_name" ]; then
                # Map the pushed source ref through each positive fetch
                # refspec. The stale ref may be renamed locally, so comparing
                # only refs/remotes/<remote>/<branch> is insufficient.
                _dest_fetch_patterns=()
                _pushed_tracking_refs=("refs/remotes/${_dest_remote_name}/${_branch_name}")
                while IFS= read -r _spec; do
                    [[ "$_spec" == ^* || "$_spec" != *:* ]] && continue
                    _source="${_spec%%:*}"
                    _source="${_source#+}"
                    _target="${_spec#*:}"
                    [ -z "$_target" ] && continue
                    _dest_fetch_patterns+=("$_target")
                    if [[ "$_source" == *\** ]]; then
                        _source_prefix="${_source%%\**}"
                        _source_suffix="${_source#*\*}"
                        if [[ "$remote_ref" == "$_source_prefix"*"$_source_suffix" ]]; then
                            _capture="${remote_ref#"$_source_prefix"}"
                            _capture="${_capture%"$_source_suffix"}"
                            _pushed_tracking_refs+=("${_target/\*/$_capture}")
                        fi
                    elif [ "$_source" = "$remote_ref" ]; then
                        _pushed_tracking_refs+=("$_target")
                    fi
                done < <(git config --get-all "remote.${_dest_remote_name}.fetch" 2>/dev/null)
                while read -r _dest_ref _dest_oid; do
                    # Fetch destinations can live outside the conventional
                    # namespace (even outside refs/remotes). Do not admit
                    # unrelated local branches or tags from the wider walk.
                    _dest_owned=false
                    if [[ "$_dest_ref" == "refs/remotes/${_dest_remote_name}/"* ]]; then
                        _dest_owned=true
                    fi
                    for _pattern in "${_dest_fetch_patterns[@]}"; do
                        # shellcheck disable=SC2053
                        if [[ "$_dest_ref" == $_pattern ]]; then
                            _dest_owned=true
                            break
                        fi
                    done
                    [ "$_dest_owned" = true ] || continue
                    # for-each-ref recursively includes configured remotes such
                    # as team/fork under team/. Their refs are not team branch
                    # baselines, even when both remotes share a destination URL.
                    _nested_remote=false
                    for _prefix in "${_protected_ref_prefixes[@]}" "${_other_remote_prefixes[@]}"; do
                        [ "$_prefix" = "refs/remotes/${_dest_remote_name}/" ] && continue
                        if [[ "$_prefix" == "refs/remotes/${_dest_remote_name}/"* && "$_dest_ref" == "$_prefix"* ]]; then
                            _nested_remote=true
                            break
                        fi
                    done
                    [ "$_nested_remote" = true ] && continue
                    _foreign_fetch=false
                    for _pattern in "${_non_dest_fetch_patterns[@]}"; do
                        # shellcheck disable=SC2053
                        if [[ "$_dest_ref" == $_pattern ]]; then
                            _foreign_fetch=true
                            break
                        fi
                    done
                    [ "$_foreign_fetch" = true ] && continue
                    _pushed_tracking=false
                    for _tracking_ref in "${_pushed_tracking_refs[@]}"; do
                        if [ "$_dest_ref" = "$_tracking_ref" ]; then
                            _pushed_tracking=true
                            break
                        fi
                    done
                    [ "$_pushed_tracking" = true ] && continue
                    [ "$_dest_ref" = "refs/remotes/${_dest_remote_name}/HEAD" ] && continue
                    _dest_other_excl="$_dest_other_excl $_dest_oid"
                done < <(git for-each-ref refs/ \
                    --format='%(refname) %(objectname)' 2>/dev/null)
            fi
            if [ -n "$_dest_other_excl" ] || [ -n "$_other_remotes" ]; then
                # shellcheck disable=SC2086
                range="$local_sha --not${_dest_other_excl}${_other_remotes}"
            else
                range="$local_sha"
            fi
        else
            # shellcheck disable=SC2086
            range="$local_sha --not $remote_sha${_other_remotes:+ $_other_remotes}"
        fi

        # O(N) protection: skip the per-commit scan when the push range is huge.
        #
        # The loop below is O(commits). A first push to a NEW remote (a mirror, a
        # backup forge, a fork) has a range of the entire history. Measured
        # 2026-08-06 pushing a brain repo to a fresh Forgejo mirror: 24,548
        # commits, 30+ minutes, 5GB read, and git had not even begun packing.
        # The failure mode is a SILENT HANG with no indication the hook is
        # running, so it reads as "the remote is broken" or "the repo is too
        # big" — both wrong, and both send you down a dead end.
        #
        # That makes any new remote unusable without --no-verify, which is
        # exactly the habit this hook exists to avoid teaching.
        #
        # One rev-list --count is fast even on huge ranges. The per-commit
        # guard is a backstop anyway: pre-commit already checks each commit's
        # staged diff as it is created, so a skip here does not leave the
        # commits unexamined.
        #
        # 0 means "no limit — always scan", which is what the skip message below
        # tells you to set. It has to be special-cased: `_range_count -gt 0` is
        # true for every non-empty range, so a plain comparison made
        # MASS_DELETE_COMMIT_RANGE_LIMIT=0 disable the guard on every push —
        # the exact opposite of the documented override, and silently.
        # A non-numeric value falls back to the default rather than erroring.
        _range_limit="${MASS_DELETE_COMMIT_RANGE_LIMIT:-500}"
        case "$_range_limit" in
            '' | *[!0-9]*) _range_limit=500 ;;
        esac
        # shellcheck disable=SC2086  # $range intentionally unquoted (may contain --not --remotes=origin)
        _range_count=$(git rev-list --count $range 2>/dev/null || echo 0)
        if [ "$_range_limit" -ne 0 ] && [ "$_range_count" -gt "$_range_limit" ]; then
            # Never skip silently — a quiet downgrade of a safety check is its own trap.
            echo "ℹ️  pre-push: skipping per-commit mass-delete scan" >&2
            echo "   Range: $_range_count commits (limit $_range_limit)." >&2
            echo "   Normal for a first push to a new remote. Each commit was still" >&2
            echo "   checked by pre-commit when it was created." >&2
            echo "   Force the full scan with: MASS_DELETE_COMMIT_RANGE_LIMIT=0 (very slow)" >&2
            continue
        fi

        # Check each commit in the range
        # shellcheck disable=SC2086  # $range intentionally unquoted (may contain --not --remotes=origin)
        for commit in $(git rev-list $range 2>/dev/null); do
            guard_mass_delete_commit "$commit"
        done
    done
fi

# --- Force-reset guard (re-push protection) ---
# After a human force-resets origin/master (e.g. to undo a bad push), an autonomous
# loop may fire and re-push the removed commits before the local branch is also reset.
# This guard detects the non-fast-forward reflog transition on origin/master and blocks.
# Bypass: ALLOW_FORCE_RESET_PUSH=1 git push ...
if [ -z "${ALLOW_FORCE_RESET_PUSH:-}" ]; then
    for line in "${STDIN_LINES[@]}"; do
        read -r local_ref local_sha remote_ref remote_sha <<< "$line"

        # Only guard pushes to master/main; skip deletions and new branches
        [[ "$remote_ref" != "refs/heads/master" && "$remote_ref" != "refs/heads/main" ]] && continue
        [ "$local_sha" = "$ZERO" ] && continue
        [ "$remote_sha" = "$ZERO" ] && continue

        # This guard is about ORIGIN's history being force-reset, so the whole
        # check — not just the fetch — is meaningless when pushing elsewhere.
        #
        # Skipping only the fetch was a half-fix: the reflog comparison below
        # reads refs/remotes/origin/$branch unconditionally, so a stale
        # non-fast-forward transition left by some earlier fetch still blocked
        # mirror pushes with an error about a remote you were not pushing to.
        #
        # Git passes the remote NAME as $1. Empty means invoked outside git
        # (tests) — keep the old behaviour there rather than silently skipping.
        #
        # Compare canonical repository identities, not raw URL strings. Git
        # accepts several spellings for the same remote (HTTPS with/without
        # `.git`, scp-style SSH, case variants), and treating an alias spelling
        # as a mirror would bypass the origin force-reset guard. Unknown URL
        # shapes fail closed by staying distinct.
        # (_canonical_remote_url is defined near the top of this hook.)

        _remote_branch="${remote_ref#refs/heads/}"
        if [ -n "${PUSH_REMOTE_NAME:-}" ] && [ "${PUSH_REMOTE_NAME:-}" != "origin" ]; then
            # `--push` on BOTH sides: the question is where a push LANDS, and
            # `remote.<name>.pushurl` overrides `url` for exactly that. Reading
            # the fetch URL inverted the guard in the case that matters most —
            # a remote whose `url` differs from origin's but whose `pushurl` IS
            # origin's compares unequal, so the guard was skipped for a push
            # that really does rewrite origin. `--push` falls back to `url`
            # when no pushurl is configured, so this is a strict refinement.
            _origin_url="$(git remote get-url --push origin 2>/dev/null || true)"
            _push_url="$(git remote get-url --push "$PUSH_REMOTE_NAME" 2>/dev/null || true)"
            _origin_identity="$(_canonical_remote_url "$_origin_url")"
            _push_identity="$(_canonical_remote_url "$_push_url")"
            # Unknown/unresolvable remote: fall through to the guard rather than
            # skipping it — an unrecognised name is not evidence of a mirror.
            if [ -n "$_origin_identity" ] && [ -n "$_push_identity" ] && [ "$_origin_identity" != "$_push_identity" ]; then
                continue
            fi
        fi

        # Safety check: if origin's pushurl points to a different repository than
        # its fetchurl, the fetch below would update the reflog for the fetch-URL
        # target, not for where the push actually lands. A force-reset on the push
        # target would be invisible to the reflog check. Fail closed rather than
        # silently running a guard that cannot see the real endpoint.
        _ofetch_url="$(git remote get-url origin 2>/dev/null || true)"
        _opush_url="$(git remote get-url --push origin 2>/dev/null || true)"
        if [ -n "$_ofetch_url" ] && [ -n "$_opush_url" ]; then
            _ofetch_id="$(_canonical_remote_url "$_ofetch_url")"
            _opush_id="$(_canonical_remote_url "$_opush_url")"
            if [ -n "$_ofetch_id" ] && [ -n "$_opush_id" ] && [ "$_ofetch_id" != "$_opush_id" ]; then
                echo "ERROR: origin.pushurl points to a different repository than origin.url." >&2
                echo "       The force-reset guard cannot verify the correct reflog endpoint." >&2
                echo "       Use one URL for both fetch and push, or bypass with:" >&2
                echo "         ALLOW_FORCE_RESET_PUSH=1 git push" >&2
                exit 1
            fi
        fi

        # Fetch to get the latest remote state (updates reflog).
        git fetch origin "$_remote_branch" --quiet 2>/dev/null || true

        # Read the two most recent entries from the remote branch reflog.
        # If the previous entry is NOT an ancestor of the current entry, a
        # force-reset (non-fast-forward update) occurred.
        reflog_current=$(git reflog show "refs/remotes/origin/$_remote_branch" --pretty=format:'%H' 2>/dev/null | sed -n '1p' || true)
        reflog_prev=$(git reflog show "refs/remotes/origin/$_remote_branch" --pretty=format:'%H' 2>/dev/null | sed -n '2p' || true)

        if [ -n "$reflog_prev" ] && [ -n "$reflog_current" ]; then
            if ! git merge-base --is-ancestor "$reflog_prev" "$reflog_current" 2>/dev/null; then
                echo "ERROR: origin/$_remote_branch was force-reset (non-fast-forward reflog transition)." >&2
                echo "  Was: $reflog_prev" >&2
                echo "  Now: $reflog_current" >&2
                echo "Push blocked — your local branch likely has commits that were deliberately removed." >&2
                echo "To align with remote:  git reset --hard origin/$_remote_branch" >&2
                echo "To override (DANGER):  ALLOW_FORCE_RESET_PUSH=1 git push" >&2
                exit 1
            fi
        fi
    done
fi

# --- Master/Main Push Protection ---
# Source allowed repos from config file (shared with pre-commit hook)
# Falls back to empty array if config doesn't exist (backwards compatible)
# No "$SCRIPT_DIR/.." fallback: through the installed hooks symlink that would
# load the shared checkout's template config instead of the agent's own.
_read_hook_conf allowed-repos.conf ALLOWED_PATTERNS || ALLOWED_PATTERNS=()

REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")

# Check if repo is in allowed patterns (matches against REMOTE_URL like pre-commit)
is_allowed=false
for pattern in "${ALLOWED_PATTERNS[@]}"; do
    if [ -n "$pattern" ] && [[ "$REMOTE_URL" == *"$pattern"* ]]; then
        is_allowed=true
        break
    fi
done

# Auto-detect agent workspace (has gptme.toml with [agent] section)
if [ "$is_allowed" = false ] && [ -f "gptme.toml" ]; then
    if grep -q '\[agent\]' "gptme.toml" 2>/dev/null; then
        is_allowed=true
    fi
fi

# Template repo itself (for development)
if [ "$is_allowed" = false ] && [[ "$REMOTE_URL" == *"gptme-agent-template"* ]]; then
    is_allowed=true
fi

# If not allowed, check for master/main pushes
if [ "$is_allowed" = false ]; then
    for line in "${STDIN_LINES[@]}"; do
        read -r _local_ref _local_sha remote_ref _remote_sha <<< "$line"
        if [[ "$remote_ref" == "refs/heads/master" || "$remote_ref" == "refs/heads/main" ]]; then
            echo "🚫 ERROR: Direct push to $remote_ref blocked!"
            echo ""
            echo "This prevents accidental pushes that bypass PR review."
            echo ""
            local_branch="${_local_ref#refs/heads/}"
            if [[ "$_local_ref" == refs/heads/* && "refs/heads/$local_branch" != "$remote_ref" ]]; then
                # A differently-named local branch is heading to master/main.
                # Check whether this is the push.default=upstream tracking trap.
                tracked_remote=$(git config "branch.${local_branch}.remote" 2>/dev/null || true)
                tracked_merge=$(git config "branch.${local_branch}.merge" 2>/dev/null || true)
                echo "Local branch '$local_branch' is being pushed to ${remote_ref#refs/heads/}."
                if [[ "$tracked_remote" == "origin" && "$tracked_merge" == "$remote_ref" ]]; then
                    echo "It tracks origin/${remote_ref#refs/heads/} — likely due to push.default=upstream."
                fi
                echo "Push it under its own name instead:"
                echo "  git push -u origin $local_branch:refs/heads/$local_branch"
            else
                echo "Create a branch and push that:"
                echo "  git switch -c feature-branch"
                echo "  git push -u origin feature-branch:refs/heads/feature-branch"
            fi
            echo ""
            echo "Do NOT retry with --no-verify: that pushes the same commits to the"
            echo "default branch. A deliberate direct push is an operator decision."
            exit 1
        fi
    done
fi

# --- Worktree Tracking Validation ---
# Pass stored stdin to validation script
printf '%s\n' "${STDIN_LINES[@]}" | "$SCRIPT_DIR/validate-worktree-tracking.sh" "$@"

# --- Git LFS support (don't fail hook if LFS has issues) ---
command -v git-lfs >/dev/null 2>&1 && printf '%s\n' "${STDIN_LINES[@]}" | git lfs pre-push "$@" 2>/dev/null || true

# --- Worktree branch-binding guard (fail-open) ---
# Auto-claims pushed branches as pr-branch:org/repo#branch coordination keys
# and warns when a live sibling session holds the claim. No-op without a
# session id in the environment; never blocks unless
# AGENT_WORKTREE_PUSH_GUARD_DENY=1 (or the legacy
# BOB_WORKTREE_PUSH_GUARD_DENY=1) is set.
# See scripts/hooks/worktree-push-guard.
#
# SECURITY: resolve the guard from the checkout that owns this hook — never
# from the repository being pushed ($REPO_ROOT). This hook is installed
# globally; executing a repo-supplied script at the same path would let any
# cloned repository run arbitrary code with the user's privileges. `$SCRIPT_DIR`
# may be a symlinked global hooks dir (core.hooksPath), so `readlink -f` + `git
# -C` finds the checkout that actually owns this hook file.
_HOOKS_REAL="$(readlink -f "$SCRIPT_DIR" 2>/dev/null || printf '%s' "$SCRIPT_DIR")"
_HOOK_REPO="$(git -C "$_HOOKS_REAL" rev-parse --show-toplevel 2>/dev/null || true)"
_GUARD=""
if [ -n "$_HOOK_REPO" ] && [ -x "$_HOOK_REPO/scripts/hooks/worktree-push-guard" ]; then
    _GUARD="$_HOOK_REPO/scripts/hooks/worktree-push-guard"
fi
if [ -n "$_GUARD" ] && [ -x "$_GUARD" ]; then
    # Exit 1 is the guard's deliberate deny signal. Startup/infrastructure
    # failures use other codes and must remain fail-open.
    _GUARD_RC=0
    printf '%s\n' "${STDIN_LINES[@]}" | "$_GUARD" "$@" || _GUARD_RC=$?
    if [ "$_GUARD_RC" -eq 1 ]; then
        exit 1
    fi
fi

exit 0
