#!/bin/bash
# Pre-push hook: mass-deletion guard, force-reset guard, branch protection, worktree validation
#
# Install globally:
#   git config --global core.hooksPath ~/.config/git/hooks

set -euo pipefail

SCRIPT_DIR="$(dirname "$0")"

# Git invokes: pre-push <remote-name> <remote-url>
# Used to skip origin-specific work when pushing to a mirror or other remote.
PUSH_REMOTE_NAME="${1:-}"

# Read stdin before any subprocess consumes it.
# Git provides per line: local_ref local_sha remote_ref remote_sha
# The `|| [ -n "$local_ref" ]` handles the last line without a trailing newline
# (e.g. when stdin comes from Python subprocess or echo without -n).
STDIN_LINES=()
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
    STDIN_LINES+=("$local_ref $local_sha $remote_ref $remote_sha")
done

# --- Mass-deletion guard (per-commit scan) ---
# Scans every commit in the push range for catastrophic deletions.
# This is the LAST line of defense before bad commits reach the remote.
# Bypass: ALLOW_MASS_DELETE=1 git push ...
ZERO="0000000000000000000000000000000000000000"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
_GUARD_SCRIPT=""
if [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/scripts/git/guard-mass-delete.sh" ]; then
    _GUARD_SCRIPT="$REPO_ROOT/scripts/git/guard-mass-delete.sh"
elif [ -n "$SCRIPT_DIR" ]; then
    _GPTME_CONTRIB_DIR="$(cd "$SCRIPT_DIR/../../../.." 2>/dev/null && pwd)"
    if [ -f "$_GPTME_CONTRIB_DIR/scripts/git/guard-mass-delete.sh" ]; then
        _GUARD_SCRIPT="$_GPTME_CONTRIB_DIR/scripts/git/guard-mass-delete.sh"
    fi
fi
if [ -n "$_GUARD_SCRIPT" ]; then
    # shellcheck source=../../../scripts/git/guard-mass-delete.sh
    source "$_GUARD_SCRIPT"

    for line in "${STDIN_LINES[@]}"; do
        read -r local_ref local_sha remote_ref remote_sha <<< "$line"

        # Skip branch deletions
        [ "$local_sha" = "$ZERO" ] && continue

        # Determine the range of commits being pushed
        if [ "$remote_sha" = "$ZERO" ]; then
            # New branch: check commits not reachable from any remote branch
            range="$local_sha --not --remotes=origin"
        else
            range="$remote_sha..$local_sha"
        fi

        # O(N) protection: skip the per-commit scan when the push range is huge.
        #
        # The loop below is O(commits). A first push to a NEW remote (a mirror, a
        # backup forge, a fork) has a range of the entire history. Measured
        # 2026-08-06 pushing a brain repo to a fresh Forgejo mirror: 24,548
        # commits, 30+ minutes, 5GB read, and git had not even begun packing.
        # The failure mode is a SILENT HANG with no indication the hook is
        # running, so it reads as "the remote is broken" or "the repo is too
        # big" — both wrong, and both send you down a dead end.
        #
        # That makes any new remote unusable without --no-verify, which is
        # exactly the habit this hook exists to avoid teaching.
        #
        # One rev-list --count is fast even on huge ranges. The per-commit
        # guard is a backstop anyway: pre-commit already checks each commit's
        # staged diff as it is created, so a skip here does not leave the
        # commits unexamined.
        #
        # 0 means "no limit — always scan", which is what the skip message below
        # tells you to set. It has to be special-cased: `_range_count -gt 0` is
        # true for every non-empty range, so a plain comparison made
        # MASS_DELETE_COMMIT_RANGE_LIMIT=0 disable the guard on every push —
        # the exact opposite of the documented override, and silently.
        # A non-numeric value falls back to the default rather than erroring.
        _range_limit="${MASS_DELETE_COMMIT_RANGE_LIMIT:-500}"
        case "$_range_limit" in
            '' | *[!0-9]*) _range_limit=500 ;;
        esac
        # shellcheck disable=SC2086  # $range intentionally unquoted (may contain --not --remotes=origin)
        _range_count=$(git rev-list --count $range 2>/dev/null || echo 0)
        if [ "$_range_limit" -ne 0 ] && [ "$_range_count" -gt "$_range_limit" ]; then
            # Never skip silently — a quiet downgrade of a safety check is its own trap.
            echo "ℹ️  pre-push: skipping per-commit mass-delete scan" >&2
            echo "   Range: $_range_count commits (limit $_range_limit)." >&2
            echo "   Normal for a first push to a new remote. Each commit was still" >&2
            echo "   checked by pre-commit when it was created." >&2
            echo "   Force the full scan with: MASS_DELETE_COMMIT_RANGE_LIMIT=0 (very slow)" >&2
            continue
        fi

        # Check each commit in the range
        # shellcheck disable=SC2086  # $range intentionally unquoted (may contain --not --remotes=origin)
        for commit in $(git rev-list $range 2>/dev/null); do
            guard_mass_delete_commit "$commit"
        done
    done
fi

# --- Force-reset guard (re-push protection) ---
# After a human force-resets origin/master (e.g. to undo a bad push), an autonomous
# loop may fire and re-push the removed commits before the local branch is also reset.
# This guard detects the non-fast-forward reflog transition on origin/master and blocks.
# Bypass: ALLOW_FORCE_RESET_PUSH=1 git push ...
if [ -z "${ALLOW_FORCE_RESET_PUSH:-}" ]; then
    for line in "${STDIN_LINES[@]}"; do
        read -r local_ref local_sha remote_ref remote_sha <<< "$line"

        # Only guard pushes to master/main; skip deletions and new branches
        [[ "$remote_ref" != "refs/heads/master" && "$remote_ref" != "refs/heads/main" ]] && continue
        [ "$local_sha" = "$ZERO" ] && continue
        [ "$remote_sha" = "$ZERO" ] && continue

        # This guard is about ORIGIN's history being force-reset, so the whole
        # check — not just the fetch — is meaningless when pushing elsewhere.
        #
        # Skipping only the fetch was a half-fix: the reflog comparison below
        # reads refs/remotes/origin/$branch unconditionally, so a stale
        # non-fast-forward transition left by some earlier fetch still blocked
        # mirror pushes with an error about a remote you were not pushing to.
        #
        # Git passes the remote NAME as $1. Empty means invoked outside git
        # (tests) — keep the old behaviour there rather than silently skipping.
        #
        # Compare canonical repository identities, not raw URL strings. Git
        # accepts several spellings for the same remote (HTTPS with/without
        # `.git`, scp-style SSH, case variants), and treating an alias spelling
        # as a mirror would bypass the origin force-reset guard. Unknown URL
        # shapes fail closed by staying distinct.
        _canonical_remote_url() {
            printf '%s\n' "$1" | sed -E \
                -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://([^@/]+@)?##' \
                -e 's#^[^/@:]+@##' \
                -e 's#^([^/:]+):[0-9]+(/|$)#\1\2#' \
                -e 's#^([^/:]+):#\1/#' \
                -e 's#^[^/]+@##' \
                -e 's#/$##' \
                -e 's#\.git$##' | tr '[:upper:]' '[:lower:]'
        }

        _remote_branch="${remote_ref#refs/heads/}"
        if [ -n "${PUSH_REMOTE_NAME:-}" ] && [ "${PUSH_REMOTE_NAME:-}" != "origin" ]; then
            # `--push` on BOTH sides: the question is where a push LANDS, and
            # `remote.<name>.pushurl` overrides `url` for exactly that. Reading
            # the fetch URL inverted the guard in the case that matters most —
            # a remote whose `url` differs from origin's but whose `pushurl` IS
            # origin's compares unequal, so the guard was skipped for a push
            # that really does rewrite origin. `--push` falls back to `url`
            # when no pushurl is configured, so this is a strict refinement.
            _origin_url="$(git remote get-url --push origin 2>/dev/null || true)"
            _push_url="$(git remote get-url --push "$PUSH_REMOTE_NAME" 2>/dev/null || true)"
            _origin_identity="$(_canonical_remote_url "$_origin_url")"
            _push_identity="$(_canonical_remote_url "$_push_url")"
            # Unknown/unresolvable remote: fall through to the guard rather than
            # skipping it — an unrecognised name is not evidence of a mirror.
            if [ -n "$_origin_identity" ] && [ -n "$_push_identity" ] && [ "$_origin_identity" != "$_push_identity" ]; then
                continue
            fi
        fi

        # Fetch to get the latest remote state (updates reflog).
        git fetch origin "$_remote_branch" --quiet 2>/dev/null || true

        # Read the two most recent entries from the remote branch reflog.
        # If the previous entry is NOT an ancestor of the current entry, a
        # force-reset (non-fast-forward update) occurred.
        reflog_current=$(git reflog show "refs/remotes/origin/$_remote_branch" --pretty=format:'%H' 2>/dev/null | sed -n '1p' || true)
        reflog_prev=$(git reflog show "refs/remotes/origin/$_remote_branch" --pretty=format:'%H' 2>/dev/null | sed -n '2p' || true)

        if [ -n "$reflog_prev" ] && [ -n "$reflog_current" ]; then
            if ! git merge-base --is-ancestor "$reflog_prev" "$reflog_current" 2>/dev/null; then
                echo "ERROR: origin/$_remote_branch was force-reset (non-fast-forward reflog transition)." >&2
                echo "  Was: $reflog_prev" >&2
                echo "  Now: $reflog_current" >&2
                echo "Push blocked — your local branch likely has commits that were deliberately removed." >&2
                echo "To align with remote:  git reset --hard origin/$_remote_branch" >&2
                echo "To override (DANGER):  ALLOW_FORCE_RESET_PUSH=1 git push" >&2
                exit 1
            fi
        fi
    done
fi

# --- Master/Main Push Protection ---
# Source allowed repos from config file (shared with pre-commit hook)
# Falls back to empty array if config doesn't exist (backwards compatible)
source "$SCRIPT_DIR/../allowed-repos.conf" 2>/dev/null || ALLOWED_PATTERNS=()

REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")

# Check if repo is in allowed patterns (matches against REMOTE_URL like pre-commit)
is_allowed=false
for pattern in "${ALLOWED_PATTERNS[@]}"; do
    if [ -n "$pattern" ] && [[ "$REMOTE_URL" == *"$pattern"* ]]; then
        is_allowed=true
        break
    fi
done

# Auto-detect agent workspace (has gptme.toml with [agent] section)
if [ "$is_allowed" = false ] && [ -f "gptme.toml" ]; then
    if grep -q '\[agent\]' "gptme.toml" 2>/dev/null; then
        is_allowed=true
    fi
fi

# Template repo itself (for development)
if [ "$is_allowed" = false ] && [[ "$REMOTE_URL" == *"gptme-agent-template"* ]]; then
    is_allowed=true
fi

# If not allowed, check for master/main pushes
if [ "$is_allowed" = false ]; then
    for line in "${STDIN_LINES[@]}"; do
        read -r _local_ref _local_sha remote_ref _remote_sha <<< "$line"
        if [[ "$remote_ref" == "refs/heads/master" || "$remote_ref" == "refs/heads/main" ]]; then
            echo "🚫 ERROR: Direct push to $remote_ref blocked!"
            echo ""
            echo "This prevents accidental pushes that bypass PR review."
            echo ""
            echo "If intentional, use: git push --no-verify"
            echo "Otherwise, create a branch:"
            echo "  git checkout -b feature-branch"
            echo "  git push -u origin feature-branch"
            exit 1
        fi
    done
fi

# --- Worktree Tracking Validation ---
# Pass stored stdin to validation script
printf '%s\n' "${STDIN_LINES[@]}" | "$SCRIPT_DIR/validate-worktree-tracking.sh" "$@"

# --- Git LFS support (don't fail hook if LFS has issues) ---
command -v git-lfs >/dev/null 2>&1 && printf '%s\n' "${STDIN_LINES[@]}" | git lfs pre-push "$@" 2>/dev/null || true

exit 0
