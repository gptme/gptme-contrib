*.pyc
__pycache__
*.egg-info
.mypy_cache
.pytest_cache
.ruff_cache

# Python build artifacts
build/
dist/

# Secrets - never commit
scripts/discord/logs/*
scripts/*/.env
scripts/*/.oauth-state
scripts/*/.tokens.json
scripts/.env
*.oauth-state
*.tokens.json
# Per-agent identity allowlist written by dotfiles/install.sh. It carries a
# machine-specific git identity and must never be committed from a checkout
# whose ~/.config is symlinked into this tree.
dotfiles/.config/git/allowed-identities.conf

.venv/
venv/
.gptme/

# Community plugins index (generated artifact — do not commit snapshots)
state/community_plugins.json
docs/community_plugins.json

# Task lock files (runtime state)
state/locks/

# Session state files (runtime state)
state/sessions/

# Stale directory from tasks->gptodo rename (PR #171)
packages/tasks/

# Dashboard build output
_site/
